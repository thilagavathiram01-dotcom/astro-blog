---
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const allTags = [...new Set(posts.flatMap(p => p.data.tags ?? []))].slice(0, 8);
const now = new Date();
const dateStr = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
---

<!-- Breaking Banner -->
<div class="breaking-banner">
  ⚡ Live Coverage: Android September 2026 Drop — AI integrations, Motion Assist & more arriving now
</div>

<!-- Masthead -->
<header class="masthead">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center py-5 border-b border-white/10">
      <!-- Date line -->
      <p class="text-white/50 text-xs tracking-widest uppercase mb-3 font-medium">{dateStr}</p>
      
      <!-- Site Name -->
      <a href="/" class="site-name text-5xl sm:text-6xl lg:text-7xl tracking-tight hover:opacity-90 transition-opacity">
        {SITE_TITLE}
      </a>
      
      <!-- Tagline -->
      <p class="text-white/40 text-xs tracking-widest mt-2 uppercase font-light">
        Technology · Artificial Intelligence · Developer Insights
      </p>

      <!-- Social + Subscribe row -->
      <div class="flex items-center gap-4 mt-4">
        <a href="/rss.xml" class="flex items-center gap-1.5 text-white/60 hover:text-white transition-colors text-xs font-medium tracking-wide">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M5 3a1 1 0 000 2c5.523 0 10 4.477 10 10a1 1 0 102 0C17 8.373 11.627 3 5 3zM4 9a1 1 0 000 2 4 4 0 014 4 1 1 0 102 0 6 6 0 00-6-6zM3 15a2 2 0 114 0 2 2 0 01-4 0z"/></svg>
          RSS Feed
        </a>
        <span class="text-white/20">|</span>
        <span class="text-white/60 text-xs tracking-wide">Est. 2026</span>
      </div>
    </div>

    <!-- Category Nav -->
    <nav class="flex items-center gap-0 overflow-x-auto py-2 scrollbar-hide">
      <a href="/" class="text-white hover:bg-white/10 text-xs font-semibold tracking-widest uppercase px-4 py-2 transition-colors whitespace-nowrap border-r border-white/10">
        Home
      </a>
      {allTags.map((tag) => (
        <a
          href={`/blog/`}
          class="text-white/70 hover:text-white hover:bg-white/10 text-xs font-medium tracking-wider uppercase px-4 py-2 transition-colors whitespace-nowrap border-r border-white/10"
        >
          {tag}
        </a>
      ))}
      <a href="/about" class="text-white/70 hover:text-white hover:bg-white/10 text-xs font-medium tracking-wider uppercase px-4 py-2 transition-colors whitespace-nowrap ml-auto">
        About
      </a>
    </nav>
  </div>
</header>

<!-- Ticker -->
<div class="ticker-wrap flex items-stretch overflow-hidden" style="height:32px">
  <span class="ticker-label flex items-center">Latest</span>
  <div class="flex-1 overflow-hidden flex items-center relative">
    <span class="ticker-content px-8">
      ✦ &nbsp; Gemini 3.8 Live launches with native audio dialogue &nbsp; ✦ &nbsp; Android September Drop adds Find Hub memory features &nbsp; ✦ &nbsp; ML Kit now supports Gemini Nano on-device inference &nbsp; ✦ &nbsp; Firebase AI Logic enters hybrid inference preview &nbsp; ✦ &nbsp; AppFunctions open platform for Android AI agents &nbsp; ✦ &nbsp; Google AI Studio expands to mobile app development &nbsp; ✦
    </span>
  </div>
</div>
