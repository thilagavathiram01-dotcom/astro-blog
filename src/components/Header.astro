---
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const allTags = [...new Set(posts.flatMap(p => p.data.tags ?? []))].slice(0, 9);
const now = new Date();
const dateStr = now.toLocaleDateString('en-US', {
  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
});

const navPages = [
  { label: 'Home', href: '/' },
  { label: 'AI & ML', href: '/search/?q=ai' },
  { label: 'Android', href: '/search/?q=android' },
  { label: 'Tutorials', href: '/search/?q=tutorials' },
  { label: 'Firebase', href: '/search/?q=firebase' },
  { label: 'About', href: '/about/' },
  { label: 'Privacy Policy', href: '/privacy/' },
  { label: 'Contact', href: '/contact/' },
];
---

<!-- ── TOP UTILITY BAR ── -->
<div style="background:#0A1628;border-bottom:1px solid rgba(255,255,255,0.08)">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-8">
      <p class="text-white/40 text-[10px] tracking-widest uppercase font-medium hidden sm:block">
        {dateStr}
      </p>
      <div class="flex items-center gap-4 ml-auto">
        <a href="/privacy/" class="text-white/40 hover:text-white/70 text-[10px] tracking-wider uppercase transition-colors">Privacy</a>
        <span class="text-white/20 text-[10px]">|</span>
        <a href="/contact/" class="text-white/40 hover:text-white/70 text-[10px] tracking-wider uppercase transition-colors">Contact</a>
        <span class="text-white/20 text-[10px]">|</span>
        <a href="/rss.xml" class="text-white/40 hover:text-white/70 text-[10px] tracking-wider uppercase transition-colors flex items-center gap-1">
          <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M5 3a1 1 0 000 2c5.523 0 10 4.477 10 10a1 1 0 102 0C17 8.373 11.627 3 5 3zM4 9a1 1 0 000 2 4 4 0 014 4 1 1 0 102 0 6 6 0 00-6-6zM3 15a2 2 0 114 0 2 2 0 01-4 0z"/>
          </svg>
          RSS
        </a>
      </div>
    </div>
  </div>
</div>

<!-- ── MASTHEAD ── -->
<header style="background:#0A1628;border-bottom:3px solid #C8102E">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between py-5 gap-5">

      <!-- Logo block -->
      <div class="flex flex-col items-center lg:items-start">
        <a href="/" class="hover:opacity-90 transition-opacity flex items-center gap-3">
          <img src="/logo.png" alt={SITE_TITLE} width="64" height="64" style="border-radius:8px;flex-shrink:0;object-fit:cover" />
          <span
            style="font-family:'Playfair Display',serif;font-weight:900;color:#fff;letter-spacing:-0.02em;line-height:1"
            class="text-4xl sm:text-5xl"
          >{SITE_TITLE}</span>
        </a>
        <p class="text-white/35 text-[10px] tracking-[0.22em] mt-1.5 uppercase font-light">
          Technology &nbsp;·&nbsp; Artificial Intelligence &nbsp;·&nbsp; Developer Insights
        </p>
      </div>

      <!-- Search bar -->
      <div class="w-full lg:w-auto lg:min-w-[340px]">
        <form action="/search/" method="get" role="search" class="relative">
          <label for="header-search" class="sr-only">Search articles</label>
          <div class="relative flex items-center">
            <!-- Search icon -->
            <svg class="absolute left-3.5 w-4 h-4 pointer-events-none" style="color:#C8102E" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            <input
              id="header-search"
              type="search"
              name="q"
              placeholder="Search stories, topics, keywords…"
              autocomplete="off"
              style="background:rgba(255,255,255,0.07);border:1.5px solid rgba(255,255,255,0.18);color:#fff;font-family:'Inter',sans-serif;font-size:0.82rem"
              class="w-full pl-10 pr-24 py-2.5 rounded-sm placeholder-white/30 focus:outline-none focus:border-[#C8102E] focus:bg-white/10 transition-all"
            />
            <button
              type="submit"
              style="background:#C8102E;font-family:'Inter',sans-serif;font-size:0.65rem;font-weight:700;letter-spacing:0.1em"
              class="absolute right-0 top-0 bottom-0 px-4 text-white uppercase tracking-widest hover:bg-[#9B0D23] transition-colors rounded-r-sm">
              Search
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ── PRIMARY NAV ── -->
    <nav aria-label="Primary navigation" style="border-top:1px solid rgba(255,255,255,0.1)">
      <ul class="flex items-center overflow-x-auto scrollbar-hide -mx-1">
        {navPages.map((page, i) => (
          <li>
            <a
              href={page.href}
              style={`font-family:'Inter',sans-serif;font-size:0.7rem;letter-spacing:0.1em`}
              class={`block px-4 py-3 font-semibold uppercase tracking-widest transition-colors whitespace-nowrap
                ${i === 0
                  ? 'text-white bg-[#C8102E] hover:bg-[#9B0D23]'
                  : 'text-white/65 hover:text-white hover:bg-white/10'
                }
              `}
            >
              {page.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<!-- ── TICKER ── -->
<div style="background:#C8102E;height:30px;overflow:hidden" class="flex items-stretch">
  <span style="background:#0A1628;font-family:'Inter',sans-serif;font-size:0.6rem;font-weight:700;letter-spacing:0.14em;color:#fff;flex-shrink:0" class="flex items-center px-3 uppercase">
    Breaking
  </span>
  <div class="flex-1 overflow-hidden flex items-center">
    <span style="display:inline-block;animation:ticker 35s linear infinite;font-family:'Inter',sans-serif;font-size:0.7rem;font-weight:500;color:#fff;white-space:nowrap" class="px-6">
      {posts.slice(0, 6).map(p => p.data.title).join('  ✦  &nbsp; ')}
      &nbsp;&nbsp;✦&nbsp;&nbsp;
      Gemini 3.8 Live launches with native audio dialogue &nbsp;✦&nbsp; Android September Drop adds Find Hub memory &nbsp;✦&nbsp; ML Kit now supports Gemini Nano on-device inference
    </span>
  </div>
</div>

<style>
  @keyframes ticker {
    0%   { transform: translateX(100vw); }
    100% { transform: translateX(-100%); }
  }
  /* hide scrollbar on nav */
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
