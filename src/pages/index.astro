---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featured = posts[0];
const secondary = posts.slice(1, 3);
const tertiary = posts.slice(3, 6);
const sidebar = posts.slice(6, 10);
const latest = posts.slice(0, 6);

const tagColors: Record<string,string> = {
  'ai': '#C8102E', 'gemini': '#1A73E8', 'android': '#3DDC84',
  'tutorials': '#F4B400', 'firebase': '#FFCA28', 'pixel': '#4285F4',
  'ai-tools': '#C8102E', 'workflow': '#0F9D58', 'productivity': '#AB47BC',
};
---

<BaseLayout title="Home" description={SITE_DESCRIPTION}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- TOP SECTION: Featured + Secondary -->
    <section class="mb-8">
      <div class="section-rule mb-5">
        <span class="section-flag">Today's Top Stories</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-0 border border-[var(--rule-light)] bg-white">
        
        <!-- FEATURED STORY (left 2/3) -->
        {featured && (
          <a href={`/blog/${featured.slug}/`} class="lg:col-span-2 col-rule block group relative">
            {featured.data.heroImage ? (
              <div class="aspect-[16/9] overflow-hidden bg-gray-100">
                <img
                  src={featured.data.heroImage}
                  alt={featured.data.title}
                  class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
                  loading="eager"
                />
              </div>
            ) : (
              <div class="aspect-[16/9] bg-gradient-to-br from-[var(--navy)] to-[#1e3a5f] flex items-center justify-center">
                <span class="text-white/10 font-['Playfair_Display'] font-black" style="font-size:clamp(5rem,15vw,12rem)">
                  {featured.data.title.charAt(0)}
                </span>
              </div>
            )}
            <div class="p-6 lg:p-8">
              <div class="dateline mb-2">
                <FormattedDate date={featured.data.pubDate} />
              </div>
              <h2 class="headline-xl mb-3 group-hover:text-[var(--crimson)] transition-colors">
                {featured.data.title}
              </h2>
              <p class="text-[var(--ink-soft)] text-base leading-relaxed mb-4 max-w-2xl">
                {featured.data.description}
              </p>
              <div class="flex flex-wrap items-center gap-2">
                {(featured.data.tags ?? []).slice(0,3).map(tag => (
                  <span class="tag-pill">{tag}</span>
                ))}
                <span class="ml-auto text-[var(--crimson)] text-sm font-semibold tracking-wide group-hover:underline">
                  Read full story →
                </span>
              </div>
            </div>
          </a>
        )}

        <!-- SECONDARY STORIES (right 1/3) -->
        <div class="flex flex-col divide-y divide-[var(--rule-light)]">
          {secondary.map((post) => (
            <a href={`/blog/${post.slug}/`} class="block p-5 group hover:bg-[var(--newsprint)] transition-colors flex-1">
              {post.data.heroImage && (
                <div class="aspect-[16/9] overflow-hidden mb-3 bg-gray-100">
                  <img
                    src={post.data.heroImage}
                    alt={post.data.title}
                    class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="dateline mb-1.5">
                <FormattedDate date={post.data.pubDate} />
              </div>
              <h3 class="headline-md mb-2 group-hover:text-[var(--crimson)] transition-colors">
                {post.data.title}
              </h3>
              <p class="text-[var(--ink-light)] text-sm leading-relaxed line-clamp-3">
                {post.data.description}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- MIDDLE: Tertiary Grid + Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
      
      <!-- Main Column: Tertiary Cards -->
      <div class="lg:col-span-2 space-y-0">
        <div class="section-rule mb-5">
          <span class="section-flag">Latest Analysis</span>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-0 border border-[var(--rule-light)] bg-white">
          {tertiary.map((post, i) => (
            <a
              href={`/blog/${post.slug}/`}
              class={`block group p-5 hover:bg-[var(--newsprint)] transition-colors ${i < tertiary.length - 1 ? 'border-b sm:border-b-0 sm:border-r border-[var(--rule-light)]' : ''} ${i === 1 ? 'sm:border-r-0 lg:border-r border-[var(--rule-light)]' : ''}`}
            >
              {post.data.heroImage && (
                <div class="aspect-[4/3] overflow-hidden mb-3 bg-gray-100">
                  <img
                    src={post.data.heroImage}
                    alt={post.data.title}
                    class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="dateline mb-1.5">
                <FormattedDate date={post.data.pubDate} />
              </div>
              <h3 class="headline-sm mb-2 group-hover:text-[var(--crimson)] transition-colors">
                {post.data.title}
              </h3>
              <p class="text-[var(--ink-light)] text-xs leading-relaxed line-clamp-3">
                {post.data.description}
              </p>
              {(post.data.tags ?? []).length > 0 && (
                <div class="mt-3">
                  <span class="tag-pill">{(post.data.tags ?? [])[0]}</span>
                </div>
              )}
            </a>
          ))}
        </div>

        <!-- ALL POSTS LIST (below grid) -->
        <div class="mt-6">
          <div class="section-rule mb-4">
            <span class="section-flag">All Stories</span>
          </div>
          <div class="space-y-0 bg-white border border-[var(--rule-light)]">
            {posts.map((post, i) => (
              <a
                href={`/blog/${post.slug}/`}
                class={`flex gap-4 p-4 group hover:bg-[var(--newsprint)] transition-colors ${i < posts.length - 1 ? 'border-b border-[var(--rule-light)]' : ''}`}
              >
                <div class="flex-shrink-0 w-6 text-center">
                  <span class="text-[var(--rule)] font-['Playfair_Display'] font-bold text-lg leading-none">
                    {String(i+1).padStart(2,'0')}
                  </span>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="dateline mb-0.5">
                    <FormattedDate date={post.data.pubDate} />
                  </div>
                  <h3 class="headline-sm group-hover:text-[var(--crimson)] transition-colors line-clamp-2 text-sm">
                    {post.data.title}
                  </h3>
                </div>
                {post.data.heroImage && (
                  <div class="flex-shrink-0 w-16 h-16 overflow-hidden bg-gray-100">
                    <img src={post.data.heroImage} alt="" class="w-full h-full object-cover" loading="lazy" />
                  </div>
                )}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- SIDEBAR -->
      <aside class="space-y-6">
        
        <!-- Must Read Widget -->
        <div class="widget p-5">
          <h3 class="widget-title mb-4 pb-2 border-b border-[var(--rule)]">Must Read</h3>
          <div class="space-y-4">
            {posts.slice(0, 5).map((post, i) => (
              <a href={`/blog/${post.slug}/`} class="flex gap-3 group">
                <span class="flex-shrink-0 font-['Playfair_Display'] font-black text-2xl leading-none text-[var(--rule)] group-hover:text-[var(--crimson)] transition-colors" style="line-height:1">
                  {i + 1}
                </span>
                <div>
                  <h4 class="text-sm font-semibold text-[var(--ink)] group-hover:text-[var(--crimson)] leading-snug transition-colors line-clamp-2">
                    {post.data.title}
                  </h4>
                  <p class="byline mt-0.5"><FormattedDate date={post.data.pubDate} /></p>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Topics Widget -->
        <div class="widget p-5">
          <h3 class="widget-title mb-4 pb-2 border-b border-[var(--rule)]">Browse by Topic</h3>
          <div class="flex flex-wrap gap-2">
            {[...new Set(posts.flatMap(p => p.data.tags ?? []))].map(tag => (
              <a href="/blog/" class="tag-pill hover:bg-[var(--navy)] hover:text-white hover:border-[var(--navy)] transition-colors cursor-pointer">
                {tag}
              </a>
            ))}
          </div>
        </div>

        <!-- Newsletter Widget -->
        <div class="widget p-5" style="border-top-color:var(--crimson)">
          <h3 class="widget-title mb-2">Daily Briefing</h3>
          <p class="text-xs text-[var(--ink-light)] mb-4 leading-relaxed">
            Get the top tech stories delivered to your inbox every morning.
          </p>
          <a
            href="/rss.xml"
            class="block w-full text-center text-white text-xs font-bold tracking-widest uppercase py-3 transition-colors"
            style="background:var(--crimson)"
          >
            Subscribe via RSS
          </a>
        </div>

        <!-- About Widget -->
        <div class="widget p-5">
          <h3 class="widget-title mb-3 pb-2 border-b border-[var(--rule)]">About TechChronicle</h3>
          <p class="text-sm text-[var(--ink-light)] leading-relaxed mb-3">
            Independent coverage of technology, AI, and developer tools. Written for builders and curious minds alike.
          </p>
          <a href="/about" class="text-[var(--crimson)] text-xs font-semibold tracking-wide hover:underline">
            Learn more →
          </a>
        </div>
      </aside>
    </div>

  </div>
</BaseLayout>
