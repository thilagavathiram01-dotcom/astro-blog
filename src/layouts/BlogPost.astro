---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags, noindex = false } = Astro.props;

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const related = allPosts.filter(p =>
  (p.data.tags ?? []).some(t => (tags ?? []).includes(t)) && p.data.title !== title
).slice(0, 3);
const recent = allPosts.filter(p => p.data.title !== title).slice(0, 5);
---

<BaseLayout title={title} description={description} image={heroImage} pubDate={pubDate} updatedDate={updatedDate} tags={tags} isArticle={true}>
  {noindex && <meta slot="head" name="robots" content="noindex, follow" />}
  <!-- Reading Progress Bar -->
  <div id="progress-bar" class="progress-bar" style="width:0%"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="text-xs text-[var(--ink-light)] mb-6 flex items-center gap-2">
      <a href="/" class="hover:text-[var(--crimson)] transition-colors font-medium">Home</a>
      <span class="text-[var(--rule)]">›</span>
      <span class="text-[var(--ink)]">{title.substring(0, 50)}{title.length > 50 ? '…' : ''}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- ARTICLE MAIN -->
      <article class="lg:col-span-2" itemscope itemtype="https://schema.org/NewsArticle">
        
        <!-- Hero Image -->
        {heroImage && (
          <div class="mb-6 overflow-hidden border border-[var(--rule-light)]">
            <img
              src={heroImage}
              alt={title}
              class="w-full h-auto object-cover max-h-[480px]"
              loading="eager"
            />
          </div>
        )}

        <!-- Article Header -->
        <header class="mb-8 pb-6 border-b border-[var(--rule)]">
          <!-- Tags -->
          {tags && tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-4">
              {tags.map((tag, i) => (
                <span class={`tag-pill ${i === 0 ? 'tag-pill-crimson' : ''}`}>{tag}</span>
              ))}
            </div>
          )}

          <!-- Headline -->
          <h1 class="headline-xl mb-4" style="font-size:clamp(1.8rem,4vw,2.8rem)">
            {title}
          </h1>

          {description && (
            <p class="text-[var(--ink-soft)] text-lg leading-relaxed mb-4 font-['Source_Serif_4'] italic">
              {description}
            </p>
          )}

          <!-- Meta row — machine-readable time tags required for Google News -->
          <div class="flex flex-wrap items-center gap-4 text-xs text-[var(--ink-light)]">
            <span class="dateline">
              <time datetime={pubDate.toISOString()} itemprop="datePublished">
                <FormattedDate date={pubDate} format="long" />
              </time>
            </span>
            {updatedDate && (
              <span class="text-[var(--ink-light)]">
                Updated:&nbsp;
                <time datetime={updatedDate.toISOString()} itemprop="dateModified">
                  <FormattedDate date={updatedDate} />
                </time>
              </span>
            )}
            <span class="text-[var(--ink-light)]" itemprop="author" itemscope itemtype="https://schema.org/Organization">
              <span class="font-semibold text-[var(--ink)]" itemprop="name">Yum News</span>
            </span>
          </div>
        </header>

        <!-- Article Body -->
        <div class="article-prose bg-white p-6 sm:p-8 border border-[var(--rule-light)]">
          <slot />
        </div>

        <!-- Social Share Bar -->
        <div class="mt-6 pt-5 border-t border-[var(--rule)]">
          <p class="text-xs font-bold tracking-widest uppercase text-[var(--ink-light)] mb-3">Share this story</p>
          <div class="flex flex-wrap gap-2" id="share-bar">
            <!-- Twitter / X -->
            <a
              id="share-x"
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(`https://news.yumpdf.com/blog/${Astro.url.pathname.split('/blog/')[1] ?? ''}`)}`}
              target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white transition-opacity hover:opacity-80"
              style="background:#000;border-radius:3px"
              aria-label="Share on X / Twitter"
            >
              <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              Share on X
            </a>
            <!-- LinkedIn -->
            <a
              id="share-linkedin"
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://news.yumpdf.com/blog/${Astro.url.pathname.split('/blog/')[1] ?? ''}`)}`}
              target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white transition-opacity hover:opacity-80"
              style="background:#0077B5;border-radius:3px"
              aria-label="Share on LinkedIn"
            >
              <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
            <!-- WhatsApp -->
            <a
              id="share-whatsapp"
              href={`https://wa.me/?text=${encodeURIComponent(title + ' ' + `https://news.yumpdf.com/blog/${Astro.url.pathname.split('/blog/')[1] ?? ''}`)}`}
              target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white transition-opacity hover:opacity-80"
              style="background:#25D366;border-radius:3px"
              aria-label="Share on WhatsApp"
            >
              <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
              WhatsApp
            </a>
            <!-- Copy link -->
            <button
              id="copy-link-btn"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold transition-colors cursor-pointer"
              style="background:var(--newsprint-dark);border:1px solid var(--rule);border-radius:3px;color:var(--ink-soft)"
              aria-label="Copy article link"
            >
              <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              Copy Link
            </button>
          </div>
        </div>

        <!-- Tags Footer -->
        {tags && tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2 items-center">
            <span class="text-xs font-bold text-[var(--ink-light)] tracking-widest uppercase mr-2">Filed under:</span>
            {tags.map(tag => (
              <a href={`/search/?q=${tag}`} class="tag-pill hover:bg-[var(--navy)] hover:text-white hover:border-[var(--navy)] transition-colors">{tag}</a>
            ))}
          </div>
        )}

        <!-- Related Articles -->
        {related.length > 0 && (
          <div class="mt-10">
            <div class="section-rule mb-5">
              <span class="section-flag">Related Stories</span>
            </div>
            <div class="grid sm:grid-cols-3 gap-0 bg-white border border-[var(--rule-light)]">
              {related.map((post, i) => (
                <a
                  href={`/blog/${post.slug}/`}
                  class={`block p-4 group hover:bg-[var(--newsprint)] transition-colors ${i < related.length - 1 ? 'border-b sm:border-b-0 sm:border-r border-[var(--rule-light)]' : ''}`}
                >
                  {post.data.heroImage && (
                    <div class="aspect-[16/9] overflow-hidden mb-3 bg-gray-100">
                      <img src={post.data.heroImage} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300" loading="lazy" />
                    </div>
                  )}
                  <p class="dateline mb-1"><FormattedDate date={post.data.pubDate} /></p>
                  <h4 class="headline-sm text-sm group-hover:text-[var(--crimson)] transition-colors line-clamp-3">
                    {post.data.title}
                  </h4>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Back Link -->
        <div class="mt-8 pt-6 border-t border-[var(--rule)]">
          <a
            href="/"
            class="inline-flex items-center gap-2 text-[var(--crimson)] font-semibold text-sm hover:underline"
          >
            ← Back to all stories
          </a>
        </div>
      </article>

      <!-- SIDEBAR -->
      <aside class="space-y-6">
        <!-- Recent Stories -->
        <div class="widget p-5">
          <h3 class="widget-title mb-4 pb-2 border-b border-[var(--rule)]">Recent Stories</h3>
          <div class="space-y-4">
            {recent.map((post, i) => (
              <a href={`/blog/${post.slug}/`} class="flex gap-3 group">
                <span class="flex-shrink-0 font-['Playfair_Display'] font-black text-xl leading-none text-[var(--rule)] group-hover:text-[var(--crimson)] transition-colors" style="line-height:1.1">
                  {String(i+1).padStart(2,'0')}
                </span>
                <div>
                  <h4 class="text-sm font-semibold text-[var(--ink)] group-hover:text-[var(--crimson)] transition-colors line-clamp-2 leading-snug">
                    {post.data.title}
                  </h4>
                  <p class="byline mt-0.5"><FormattedDate date={post.data.pubDate} /></p>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Topics -->
        <div class="widget p-5">
          <h3 class="widget-title mb-4 pb-2 border-b border-[var(--rule)]">Topics</h3>
          <div class="flex flex-wrap gap-2">
            {(tags ?? []).map(tag => (
              <span class="tag-pill tag-pill-crimson">{tag}</span>
            ))}
          </div>
        </div>

        <!-- About -->
        <div class="widget p-5">
          <h3 class="widget-title mb-3 pb-2 border-b border-[var(--rule)]">About</h3>
          <p class="text-sm text-[var(--ink-light)] leading-relaxed mb-3">
            Yum News covers the technology stories that matter to developers, makers, and the curious.
          </p>
          <a href="/about" class="text-[var(--crimson)] text-xs font-semibold tracking-wide hover:underline">
            About Yum News →
          </a>
        </div>

        <!-- RSS Widget -->
        <div class="widget p-5" style="border-top-color:var(--crimson)">
          <h3 class="widget-title mb-2">Stay Informed</h3>
          <p class="text-xs text-[var(--ink-light)] mb-4 leading-relaxed">Get every new story delivered directly via RSS.</p>
          <a
            href="/rss.xml"
            class="block w-full text-center text-white text-xs font-bold tracking-widest uppercase py-3"
            style="background:var(--crimson)"
          >
            Subscribe via RSS
          </a>
        </div>
      </aside>
    </div>
  </div>

  <script>
    // Reading progress bar
    const bar = document.getElementById('progress-bar');
    if (bar) {
      window.addEventListener('scroll', () => {
        const doc = document.documentElement;
        const scrolled = doc.scrollTop / (doc.scrollHeight - doc.clientHeight);
        bar.style.width = `${Math.min(scrolled * 100, 100)}%`;
      });
    }
  </script>

  <script is:inline define:vars={{ title }}>
    // GA4 — Article read event (fires after 10 s on the page)
    setTimeout(function () {
      if (typeof gtag !== 'undefined') {
        gtag('event', 'article_read', {
          event_category: 'engagement',
          article_title: title
        });
      }
    }, 10000);

    // GA4 — Scroll depth milestones (25 / 50 / 75 / 100 %)
    (function () {
      const milestones = [25, 50, 75, 100];
      const fired = new Set();

      window.addEventListener('scroll', function () {
        const doc = document.documentElement;
        const pct = Math.round(doc.scrollTop / (doc.scrollHeight - doc.clientHeight) * 100);
        milestones.forEach(function (m) {
          if (pct >= m && !fired.has(m)) {
            fired.add(m);
            if (typeof gtag !== 'undefined') {
              gtag('event', 'scroll_depth', {
                event_category: 'engagement',
                article_title: title,
                depth_percent: m
              });
            }
          }
        });
      }, { passive: true });
    })();

    // GA4 — Outbound link clicks
    document.addEventListener('click', function (e) {
      const anchor = e.target.closest('a');
      if (!anchor) return;
      const href = anchor.href || '';
      if (href && !href.startsWith(window.location.origin) && href.startsWith('http')) {
        if (typeof gtag !== 'undefined') {
          gtag('event', 'outbound_link_click', {
            event_category: 'outbound',
            link_url: href,
            article_title: title
          });
        }
      }
    });

    // Copy Link button
    var copyBtn = document.getElementById('copy-link-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        navigator.clipboard.writeText(window.location.href).then(function () {
          copyBtn.textContent = '✓ Copied!';
          copyBtn.style.color = '#22c55e';
          setTimeout(function () {
            copyBtn.innerHTML = '<svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg> Copy Link';
            copyBtn.style.color = '';
          }, 2000);
        });
        if (typeof gtag !== 'undefined') {
          gtag('event', 'share', { method: 'copy_link', content_id: window.location.href, article_title: title });
        }
      });
    }

    // GA4 — Share button clicks
    ['share-x','share-linkedin','share-whatsapp'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) {
        el.addEventListener('click', function() {
          if (typeof gtag !== 'undefined') {
            gtag('event', 'share', { method: id.replace('share-',''), content_id: window.location.href, article_title: title });
          }
        });
      }
    });
  </script>
</BaseLayout>
