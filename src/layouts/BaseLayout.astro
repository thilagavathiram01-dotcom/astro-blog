---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  isArticle?: boolean;
}

const { title, description, image, pubDate, updatedDate, tags, isArticle } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      pubDate={pubDate}
      updatedDate={updatedDate}
      tags={tags}
      isArticle={isArticle}
    />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col" style="background:var(--newsprint)">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
